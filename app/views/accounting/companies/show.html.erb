<% content_for :title, @company.name %>
<% status = fator_r_status(@window) %>
<% optimization = @window.optimization %>

<header class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-sm text-muted">
      <%= link_to "Carteira", contabil_path, class: "hover:text-ink transition-colors" %>
    </p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-ink"><%= @company.name %></h1>
    <p class="mt-0.5 text-sm text-muted"><%= @company.cnpj_formatted %></p>
  </div>

  <div class="flex items-center gap-2">
    <%= link_to "Competências", contabil_company_competencias_path(@company), class: "btn-ghost text-sm" %>
    <%= link_to "Editar", edit_contabil_company_path(@company), class: "btn-ghost text-sm" %>
  </div>
</header>

<%# Navegação de mês: o fator R muda a cada competência, então a data em foco
    precisa estar sempre visível e ser fácil de trocar. %>
<div class="mt-6 flex items-center gap-2">
  <%= link_to "‹", contabil_company_path(@company, month: (@month << 1).strftime("%Y-%m")),
              class: "btn-ghost px-3" %>
  <span class="text-sm text-ink px-3 py-2 rounded-lg bg-elevated"><%= month_label(@month) %></span>
  <%= link_to "›", contabil_company_path(@company, month: (@month >> 1).strftime("%Y-%m")),
              class: "btn-ghost px-3" %>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="card">
    <p class="text-sm text-muted">Fator R</p>
    <p class="mt-1 text-2xl font-semibold text-ink"><%= percent(@window.fator_r.value) %></p>
    <p class="mt-1 text-xs text-muted">limite de <%= percent(Tax::FatorR::THRESHOLD, precision: 0) %></p>
  </div>

  <div class="card">
    <p class="text-sm text-muted">Enquadramento</p>
    <p class="mt-1 text-2xl font-semibold text-ink"><%= status[:label] %></p>
    <p class="mt-1 text-xs <%= status[:tone] == :danger ? 'text-expense' : status[:tone] == :warning ? 'text-amber-400' : 'text-income' %>">
      <%= status[:note] %>
    </p>
  </div>

  <div class="card">
    <p class="text-sm text-muted">Receita 12 meses</p>
    <p class="mt-1 text-2xl font-semibold text-ink"><%= money(@window.rbt12) %></p>
    <p class="mt-1 text-xs text-muted">
      <%= @window.proportional? ? "proporcionalizada (#{@window.elapsed_months} meses)" : "janela cheia" %>
    </p>
  </div>

  <div class="card">
    <p class="text-sm text-muted">Folha 12 meses</p>
    <p class="mt-1 text-2xl font-semibold text-ink"><%= money(@window.folha12) %></p>
    <p class="mt-1 text-xs text-muted">DAS de <%= money(@window.simples.annual_das) %>/ano</p>
  </div>
</div>

<%# ── Simulação ────────────────────────────────────────────────────────── %>
<div class="mt-6 grid gap-4 lg:grid-cols-3">
  <div class="card lg:col-span-2">
    <h2 class="font-medium text-ink">
      <%= @window.fator_r.reaches? ? "Manutenção do Anexo III" : "Simulação de migração" %>
    </h2>

    <% if @window.fator_r.reaches? %>
      <p class="mt-3 text-sm text-muted leading-relaxed">
        A empresa está no anexo barato. Para continuar, a folha dos 12 meses não
        pode cair abaixo de <%= money(@window.fator_r.required_folha) %> —
        o que hoje pede pelo menos
        <strong class="text-ink"><%= money(optimization.required_monthly_prolabore) %>/mês</strong>
        de pró-labore se o faturamento se mantiver.
      </p>
      <% if status[:tone] == :warning %>
        <p class="mt-4 rounded-lg border border-amber-400/25 bg-amber-400/10 text-amber-400 px-4 py-3 text-sm">
          Margem estreita. Um mês de faturamento acima da média derruba o fator R
          abaixo do limite, e a empresa volta ao Anexo V sem aviso.
        </p>
      <% end %>
    <% else %>
      <p class="mt-3 text-sm text-muted leading-relaxed">
        Pagando
        <strong class="text-ink"><%= money(optimization.required_monthly_prolabore) %>/mês</strong>
        de pró-labore, a folha de 12 meses fecha os <%= percent(Tax::FatorR::THRESHOLD, precision: 0) %>
        e a empresa passa a tributar pelo Anexo III.
        <% if optimization.floored_by_minimum_wage? %>
          Esse valor é o salário mínimo, que é o piso legal — os 28% pediriam menos.
        <% end %>
      </p>

      <table class="mt-5 w-full text-sm">
        <tbody class="divide-y divide-hairline">
          <tr>
            <td class="py-2 text-muted">DAS hoje (Anexo V)</td>
            <td class="py-2 text-right text-ink"><%= money(optimization.staying.annual_das) %></td>
          </tr>
          <tr>
            <td class="py-2 text-muted">DAS no Anexo III</td>
            <td class="py-2 text-right text-ink"><%= money(optimization.switching.annual_das) %></td>
          </tr>
          <tr>
            <td class="py-2 text-income">Economia no DAS</td>
            <td class="py-2 text-right text-income"><%= money(optimization.das_saving) %></td>
          </tr>
          <tr>
            <td class="py-2 text-muted">INSS sobre o pró-labore</td>
            <td class="py-2 text-right text-expense">−<%= money(optimization.annual_inss) %></td>
          </tr>
          <tr>
            <td class="py-2 text-muted">IRRF sobre o pró-labore</td>
            <td class="py-2 text-right <%= optimization.annual_irrf.zero? ? 'text-muted' : 'text-expense' %>">
              <%= optimization.annual_irrf.zero? ? "isento" : "−#{money(optimization.annual_irrf)}" %>
            </td>
          </tr>
        </tbody>
        <tfoot>
          <tr class="border-t-2 border-hairline">
            <td class="pt-3 font-medium text-ink">Saldo no ano</td>
            <td class="pt-3 text-right font-semibold <%= optimization.worth_it? ? 'text-income' : 'text-expense' %>">
              <%= money(optimization.net_saving, signed: true) %>
            </td>
          </tr>
        </tfoot>
      </table>

      <p class="mt-4 text-sm <%= optimization.worth_it? ? 'text-muted' : 'text-expense' %> leading-relaxed">
        <% if optimization.worth_it? %>
          Cerca de <strong class="text-income"><%= money(optimization.monthly_net_saving) %></strong>
          por mês no bolso. O pró-labore em si não é custo: esse dinheiro já
          chegaria ao sócio como distribuição de lucros — o que se paga a mais é
          só o INSS e o IRRF sobre ele.
        <% else %>
          Neste faturamento a migração não compensa: o IRRF sobre o pró-labore
          necessário supera a diferença entre os anexos.
        <% end %>
      </p>
    <% end %>
  </div>

  <div class="card">
    <h2 class="font-medium text-ink">Últimas competências</h2>

    <% if @recent.empty? %>
      <p class="mt-3 text-sm text-muted">Nenhuma lançada ainda.</p>
      <p class="mt-4">
        <%= link_to "Lançar a primeira", new_contabil_company_competencia_path(@company),
                    class: "btn-primary text-sm w-full" %>
      </p>
    <% else %>
      <ul class="mt-3 divide-y divide-hairline text-sm">
        <% @recent.first(6).each do |competencia| %>
          <li class="py-2 flex items-center justify-between gap-3">
            <span class="text-muted"><%= month_label(competencia.month) %></span>
            <span class="text-ink"><%= money(competencia.gross_revenue) %></span>
          </li>
        <% end %>
      </ul>
      <p class="mt-4">
        <%= link_to "Ver todas", contabil_company_competencias_path(@company),
                    class: "btn-ghost text-sm w-full" %>
      </p>
    <% end %>
  </div>
</div>
