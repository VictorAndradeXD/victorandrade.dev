<%= form_with model: account, class: "space-y-6" do |form| %>
  <%= render "shared/errors", record: account %>

  <div class="card space-y-5">
    <div>
      <%= form.label :name, "Nome", class: "label" %>
      <%= form.text_field :name, placeholder: "Nubank", autofocus: true %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :kind, "Tipo", class: "label" %>
        <%= form.select :kind, Account::KINDS.map { |kind| [ t("account.kinds.#{kind}"), kind ] } %>
      </div>

      <%= render "shared/money_field", form: form, field: :initial_balance,
            label: "Saldo inicial", min: nil %>
    </div>

    <label class="flex items-center gap-2 text-sm text-muted">
      <%= form.check_box :archived %>
      Arquivada (não aparece em novos lançamentos)
    </label>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit account.persisted? ? "Salvar" : "Criar conta", class: "btn-primary" %>
    <%= link_to "Cancelar", accounts_path, class: "btn-ghost" %>
  </div>
<% end %>
