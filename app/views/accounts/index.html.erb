<% content_for :title, "Contas" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold tracking-tight">Contas</h1>
  <%= link_to "Nova conta", new_account_path, class: "btn-primary text-sm" %>
</div>

<div class="card">
  <% if @accounts.any? %>
    <ul class="divide-y divide-hairline">
      <% @accounts.each do |account| %>
        <li class="py-3 first:pt-0 last:pb-0 flex items-center gap-3">
          <div class="min-w-0 flex-1">
            <p class="font-medium truncate">
              <%= account.name %>
              <% if account.archived? %>
                <span class="ml-2 text-xs text-muted border border-hairline rounded px-1.5 py-0.5">arquivada</span>
              <% end %>
            </p>
            <p class="text-xs text-muted mt-0.5"><%= t("account.kinds.#{account.kind}") %></p>
          </div>

          <span class="tabular-nums font-medium <%= amount_color(account.balance) %>"><%= money(account.balance) %></span>

          <div class="flex items-center gap-1 shrink-0">
            <%= link_to action_icon(:pencil), edit_account_path(account),
                  class: icon_button_classes, title: "Editar", aria: { label: "Editar #{account.name}" } %>
            <%= button_to account, method: :delete, class: icon_button_classes(:danger),
                  title: "Excluir", aria: { label: "Excluir #{account.name}" },
                  form: { data: { turbo_confirm: "Excluir #{account.name}?" } } do %>
              <%= action_icon(:trash) %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted text-sm py-10 text-center">
      Nenhuma conta ainda. <%= link_to "Criar a primeira", new_account_path, class: "text-brand hover:underline" %>.
    </p>
  <% end %>
</div>
