<%
  color = case tone
          when :income  then "text-income"
          when :expense then "text-expense"
          when :signed  then amount_color(amount)
          else "text-ink"
          end
  display = tone == :signed ? money(amount, signed: true) : money(amount)
%>
<div class="card">
  <p class="text-muted text-sm"><%= label %></p>
  <p class="text-2xl font-semibold mt-2 <%= color %>"><%= display %></p>
</div>
