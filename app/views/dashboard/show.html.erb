<% content_for :title, "Visão geral" %>

<div class="flex flex-wrap items-end justify-between gap-4 mb-7">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight">Bom dia, <%= current_user.display_name %>!</h1>
    <p class="text-muted mt-1">O que está acontecendo hoje?</p>
  </div>

  <div class="flex items-center gap-2">
    <%= link_to "‹", denfis_root_path(month: (@month - 1.month).strftime("%Y-%m")), class: "btn-ghost px-3" %>
    <span class="px-3 py-2 rounded-lg bg-elevated border border-hairline text-sm"><%= month_label(@month) %></span>
    <%= link_to "›", denfis_root_path(month: (@month + 1.month).strftime("%Y-%m")), class: "btn-ghost px-3" %>
  </div>
</div>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
  <%= render "summary_card", label: "Resultado do período", amount: @result, tone: :signed %>
  <%= render "summary_card", label: "Receitas",             amount: @income,  tone: :income %>
  <%= render "summary_card", label: "Despesas",             amount: @expense, tone: :expense %>
  <%= render "summary_card", label: "Saldo em contas",      amount: @balance, tone: :neutral %>
</div>

<div class="grid gap-6 lg:grid-cols-5">
  <section class="card lg:col-span-3">
    <h2 class="font-medium mb-1">Saldo por dia</h2>
    <p class="text-muted text-sm mb-4"><%= month_label(@month) %> — quanto entrou e saiu em cada dia</p>
    <p class="text-2xl font-semibold <%= amount_color(@result) %> mb-5"><%= money(@result, signed: true) %></p>

    <%= render "calendar", month: @month, daily: @daily %>
  </section>

  <section class="card lg:col-span-2">
    <h2 class="font-medium mb-1">Por tags</h2>
    <p class="text-muted text-sm mb-4">Despesas do período</p>

    <% if @by_tag.any? || @untagged.positive? %>
      <%= render "tag_donut", by_tag: @by_tag, untagged: @untagged, total: @expense %>
    <% else %>
      <p class="text-muted text-sm py-10 text-center">Nenhuma despesa neste período.</p>
    <% end %>
  </section>
</div>

<%# Alvo do clique no calendário: o dia chega aqui e vira um <dialog> modal. %>
<%= turbo_frame_tag "day_detail" %>

<section class="card mt-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="font-medium">Últimos lançamentos</h2>
    <%= link_to "Ver todos →", transactions_path(month: @month.strftime("%Y-%m")), class: "text-sm text-brand hover:underline" %>
  </div>

  <% if @recent.any? %>
    <%= render "transactions/list", transactions: @recent %>
  <% else %>
    <p class="text-muted text-sm py-6 text-center">
      Nada por aqui ainda. <%= link_to "Criar o primeiro lançamento", new_transaction_path, class: "text-brand hover:underline" %>.
    </p>
  <% end %>
</section>
