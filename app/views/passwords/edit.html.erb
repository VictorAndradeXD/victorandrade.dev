<% content_for :title, "Nova senha" %>

<div class="mx-auto max-w-sm mt-16">
  <h1 class="text-2xl font-semibold tracking-tight mb-6">Defina uma nova senha</h1>

  <div class="card">
    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :password, "Nova senha", class: "label" %>
        <%= form.password_field :password, required: true, autofocus: true,
              autocomplete: "new-password", maxlength: 72 %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirme a senha", class: "label" %>
        <%= form.password_field :password_confirmation, required: true,
              autocomplete: "new-password", maxlength: 72 %>
      </div>

      <%= form.submit "Salvar senha", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
