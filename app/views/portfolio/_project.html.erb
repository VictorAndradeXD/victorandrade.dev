<%# Um projeto da seção "Selected work". Os metadados (stack, links) vêm do
    PORO; o texto vem do locale, casado pela chave project[:id]. %>
<% copy = t("portfolio.projects.#{project[:id]}") %>

<article class="card relative overflow-hidden">
  <%# Fio de destaque à esquerda: dá hierarquia sem pesar o cartão. %>
  <span class="absolute inset-y-0 left-0 w-px bg-brand/60" aria-hidden="true"></span>

  <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h3 class="text-lg font-semibold text-ink tracking-tight"><%= copy[:name] %></h3>
    <p class="text-sm text-muted"><%= copy[:kind] %></p>
  </header>

  <p class="mt-3 text-ink/90 leading-relaxed"><%= copy[:summary] %></p>

  <ul class="mt-4 space-y-2 text-sm text-muted">
    <% copy[:highlights].each do |highlight| %>
      <li class="flex gap-2.5">
        <span class="text-brand mt-1.5 shrink-0" aria-hidden="true">▸</span>
        <span class="leading-relaxed"><%= highlight %></span>
      </li>
    <% end %>
  </ul>

  <ul class="mt-5 flex flex-wrap gap-1.5">
    <% project[:stack].each do |tech| %>
      <li class="text-xs text-muted bg-elevated border border-hairline rounded-md px-2 py-1"><%= tech %></li>
    <% end %>
  </ul>

  <% if project[:live] || project[:code] %>
    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <% if project[:live] %>
        <%= link_to project[:live][:url], class: "text-brand hover:underline underline-offset-4 font-medium",
                    target: "_blank", rel: "noopener" do %>
          <%= project[:live][:label] %> <span aria-hidden="true">↗</span>
        <% end %>
      <% end %>
      <% if project[:code] %>
        <%= link_to project[:code][:url], class: "text-muted hover:text-ink transition-colors",
                    target: "_blank", rel: "noopener" do %>
          <%= project[:code][:label] %> <span aria-hidden="true">↗</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</article>
