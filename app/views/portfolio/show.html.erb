<%# ── Hero ──────────────────────────────────────────────────────────────── %>
<section class="hero-glow border-b border-hairline">
  <div class="mx-auto max-w-5xl px-5 py-20 sm:py-28">
    <p class="inline-flex items-center gap-2 text-sm text-income bg-income/10 border border-income/25 rounded-full px-3 py-1">
      <span class="w-1.5 h-1.5 rounded-full bg-income" aria-hidden="true"></span>
      <%= t("portfolio.profile.available") %>
    </p>

    <h1 class="mt-6 text-4xl sm:text-6xl font-semibold tracking-tight text-ink">
      <%= t("portfolio.profile.name") %>
    </h1>
    <p class="mt-2 text-lg text-brand font-medium"><%= t("portfolio.profile.role") %></p>

    <p class="mt-6 max-w-2xl text-xl sm:text-2xl text-ink/90 leading-snug tracking-tight">
      <%= t("portfolio.profile.headline") %>
    </p>
    <p class="mt-5 max-w-2xl text-muted leading-relaxed">
      <%= t("portfolio.profile.blurb") %>
    </p>

    <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm">
      <div>
        <dt class="text-muted"><%= t("portfolio.profile.based_in_label") %></dt>
        <dd class="text-ink mt-0.5"><%= t("portfolio.profile.based_in") %></dd>
      </div>
      <div>
        <dt class="text-muted"><%= t("portfolio.profile.timezone_label") %></dt>
        <dd class="text-ink mt-0.5"><%= t("portfolio.profile.timezone") %></dd>
      </div>
      <div>
        <dt class="text-muted"><%= t("portfolio.profile.languages_label") %></dt>
        <dd class="text-ink mt-0.5"><%= t("portfolio.profile.languages") %></dd>
      </div>
    </dl>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <%= link_to t("portfolio.actions.get_in_touch"), "mailto:#{Portfolio::LINKS[:email]}", class: "btn-primary" %>
      <%= link_to "GitHub",   Portfolio::LINKS[:github],   class: "btn-ghost", target: "_blank", rel: "me noopener" %>
      <%= link_to "LinkedIn", Portfolio::LINKS[:linkedin], class: "btn-ghost", target: "_blank", rel: "me noopener" %>
      <% if resume_available? %>
        <%= link_to t("portfolio.actions.resume"), Portfolio::RESUME_PATH, class: "btn-ghost", target: "_blank", rel: "noopener" %>
      <% end %>
    </div>
  </div>
</section>

<%# ── Trabalhos selecionados ────────────────────────────────────────────── %>
<section id="work" class="scroll-mt-20 mx-auto max-w-5xl px-5 py-20">
  <header class="flex items-baseline justify-between gap-4">
    <h2 class="text-2xl font-semibold tracking-tight text-ink"><%= t("portfolio.work.title") %></h2>
    <p class="text-sm text-muted"><%= t("portfolio.work.note") %></p>
  </header>

  <div class="mt-8 space-y-6">
    <%= render partial: "portfolio/project", collection: Portfolio::PROJECTS, as: :project %>
  </div>
</section>

<%# ── Experiência ───────────────────────────────────────────────────────── %>
<section id="experience" class="scroll-mt-20 border-t border-hairline">
  <div class="mx-auto max-w-5xl px-5 py-20">
    <h2 class="text-2xl font-semibold tracking-tight text-ink"><%= t("portfolio.experience.title") %></h2>

    <%# Régua vertical contínua com um ponto por cargo; o ring cor de canvas
        abre o buraco na régua sem precisar recortá-la. %>
    <ol class="mt-8 border-l border-hairline">
      <% t("portfolio.experience.jobs").each do |job| %>
        <li class="relative pl-8 pb-9 last:pb-0">
          <span class="absolute -left-[4.5px] top-1.5 w-2 h-2 rounded-full bg-brand ring-4 ring-canvas" aria-hidden="true"></span>

          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
            <h3 class="font-medium text-ink"><%= job[:role] %></h3>
            <span class="text-brand text-sm">·</span>
            <p class="text-ink/80"><%= job[:org] %></p>
          </div>
          <p class="mt-1 text-sm text-muted"><%= job[:period] %> · <%= job[:place] %></p>
          <p class="mt-2 text-sm text-muted leading-relaxed max-w-2xl"><%= job[:note] %></p>
        </li>
      <% end %>
    </ol>

    <% education = t("portfolio.experience.education") %>
    <div class="mt-10 pt-8 border-t border-hairline">
      <h3 class="text-sm uppercase tracking-wider text-muted"><%= t("portfolio.experience.education_label") %></h3>
      <p class="mt-3 font-medium text-ink"><%= education[:degree] %></p>
      <p class="mt-0.5 text-ink/80"><%= education[:org] %> · <span class="text-muted"><%= education[:period] %></span></p>
      <p class="mt-2 text-sm text-muted max-w-2xl leading-relaxed"><%= education[:note] %></p>
    </div>
  </div>
</section>

<%# ── Stack ─────────────────────────────────────────────────────────────── %>
<section id="stack" class="scroll-mt-20 border-t border-hairline">
  <div class="mx-auto max-w-5xl px-5 py-20">
    <h2 class="text-2xl font-semibold tracking-tight text-ink"><%= t("portfolio.stack.title") %></h2>

    <dl class="mt-8 grid gap-x-10 gap-y-7 sm:grid-cols-2">
      <% Portfolio::STACK.each do |group, items| %>
        <div>
          <dt class="text-sm uppercase tracking-wider text-muted"><%= t("portfolio.stack.groups.#{group}") %></dt>
          <dd class="mt-3">
            <ul class="flex flex-wrap gap-1.5">
              <% items.each do |item| %>
                <li class="text-sm text-ink/85 bg-elevated border border-hairline rounded-md px-2.5 py-1"><%= item %></li>
              <% end %>
            </ul>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>

<%# ── Contato ───────────────────────────────────────────────────────────── %>
<section id="contact" class="scroll-mt-20 border-t border-hairline">
  <div class="mx-auto max-w-5xl px-5 py-20">
    <h2 class="text-2xl font-semibold tracking-tight text-ink"><%= t("portfolio.contact.title") %></h2>
    <p class="mt-4 max-w-2xl text-muted leading-relaxed"><%= t("portfolio.contact.body") %></p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <%= link_to Portfolio::LINKS[:email], "mailto:#{Portfolio::LINKS[:email]}", class: "btn-primary" %>
      <%= link_to "LinkedIn", Portfolio::LINKS[:linkedin], class: "btn-ghost", target: "_blank", rel: "me noopener" %>
    </div>
  </div>
</section>
