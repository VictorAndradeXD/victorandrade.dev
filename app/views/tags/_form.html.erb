<%= form_with model: tag, class: "space-y-6" do |form| %>
  <%= render "shared/errors", record: tag %>

  <div class="card grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :name, "Nome", class: "label" %>
      <%= form.text_field :name, placeholder: "Alimentação", autofocus: true %>
    </div>

    <div>
      <%= form.label :color, "Cor", class: "label" %>
      <%= form.color_field :color, class: "h-10 p-1 cursor-pointer" %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit tag.persisted? ? "Salvar" : "Criar tag", class: "btn-primary" %>
    <%= link_to "Cancelar", tags_path, class: "btn-ghost" %>
  </div>
<% end %>
