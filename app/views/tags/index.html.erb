<% content_for :title, "Tags" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold tracking-tight">Tags</h1>
  <%= link_to "Nova tag", new_tag_path, class: "btn-primary text-sm" %>
</div>

<div class="card">
  <% if @tags.any? %>
    <ul class="divide-y divide-hairline">
      <% @tags.each do |tag| %>
        <li class="py-3 first:pt-0 last:pb-0 flex items-center gap-3">
          <span class="w-3 h-3 rounded-full shrink-0" style="background: <%= tag.color %>"></span>
          <span class="flex-1 min-w-0 truncate font-medium"><%= tag.name %></span>
          <span class="text-xs text-muted"><%= pluralize(tag.transactions.count, "lançamento") %></span>

          <div class="flex items-center gap-1 shrink-0">
            <%= link_to action_icon(:pencil), edit_tag_path(tag),
                  class: icon_button_classes, title: "Editar", aria: { label: "Editar #{tag.name}" } %>
            <%= button_to tag, method: :delete, class: icon_button_classes(:danger),
                  title: "Excluir", aria: { label: "Excluir #{tag.name}" },
                  form: { data: { turbo_confirm: "Excluir #{tag.name}? Os lançamentos ficam sem tag." } } do %>
              <%= action_icon(:trash) %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted text-sm py-10 text-center">
      Nenhuma tag ainda. <%= link_to "Criar a primeira", new_tag_path, class: "text-brand hover:underline" %>.
    </p>
  <% end %>
</div>
