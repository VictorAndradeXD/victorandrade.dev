<% content_for :title, @transaction.description %>

<div class="max-w-2xl">
  <div class="flex items-center gap-2 text-sm text-muted mb-4">
    <%= link_to "← Lançamentos", transactions_path(month: @transaction.occurred_on.strftime("%Y-%m")),
          class: "hover:text-ink" %>
  </div>

  <div class="card">
    <div class="flex items-start justify-between gap-4 mb-6">
      <div class="min-w-0">
        <span class="inline-block text-xs px-2 py-0.5 rounded border mb-2
                     <%= @transaction.expense? ? "text-expense border-expense/40" : "text-income border-income/40" %>">
          <%= t("transaction.kinds.#{@transaction.kind}") %>
        </span>
        <h1 class="text-2xl font-semibold tracking-tight break-words"><%= @transaction.description %></h1>
      </div>

      <span class="text-2xl font-semibold tabular-nums shrink-0 <%= amount_color(@transaction.signed_amount) %>">
        <%= money(@transaction.signed_amount, signed: true) %>
      </span>
    </div>

    <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-2 text-sm">
      <div>
        <dt class="text-muted">Data</dt>
        <dd class="mt-0.5"><%= long_date(@transaction.occurred_on) %></dd>
      </div>

      <div>
        <dt class="text-muted">Conta</dt>
        <dd class="mt-0.5">
          <%= @transaction.account.name %>
          <span class="text-muted">· <%= t("account.kinds.#{@transaction.account.kind}") %></span>
        </dd>
      </div>

      <div>
        <dt class="text-muted">Tag</dt>
        <dd class="mt-0.5">
          <% if @transaction.tag %>
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full" style="background: <%= @transaction.tag.color %>"></span>
              <%= @transaction.tag.name %>
            </span>
          <% else %>
            <span class="text-muted">Sem tag</span>
          <% end %>
        </dd>
      </div>

      <% if @transaction.installment_plan %>
        <div>
          <dt class="text-muted">Parcelamento</dt>
          <dd class="mt-0.5">
            Parcela <%= @transaction.installment_number %> de
            <%= @transaction.installment_plan.installments_count %>
            <span class="text-muted">· total <%= money(@transaction.installment_plan.total_amount) %></span>
          </dd>
        </div>
      <% end %>

      <% if @transaction.recurring_rule %>
        <div>
          <dt class="text-muted">Origem</dt>
          <dd class="mt-0.5">
            Gerado pela recorrência
            <%= link_to @transaction.recurring_rule.description, recurring_rules_path, class: "text-brand hover:underline" %>
          </dd>
        </div>
      <% end %>
    </dl>

    <div class="mt-6 pt-5 border-t border-hairline">
      <h2 class="font-medium mb-1">Detalhamento</h2>

      <% if @transaction.items.any? %>
        <p class="text-muted text-sm mb-3">
          <%= money(@transaction.items_total) %> de <%= money(@transaction.amount) %> descritos
          (<%= (@transaction.items_total / @transaction.amount * 100).round %>%)
        </p>

        <%# Barra de proporção: o quanto do valor já tem descrição. %>
        <div class="h-1.5 rounded-full bg-elevated overflow-hidden mb-4">
          <div class="h-full bg-brand" style="width: <%= (@transaction.items_total / @transaction.amount * 100).round(2) %>%"></div>
        </div>

        <ul class="space-y-2">
          <% @transaction.items.each do |item| %>
            <li class="flex items-center justify-between text-sm">
              <span class="truncate"><%= item.description %></span>
              <span class="tabular-nums"><%= money(item.amount) %></span>
            </li>
          <% end %>

          <% if @transaction.undescribed_amount.positive? %>
            <li class="flex items-center justify-between text-sm text-muted italic pt-2 border-t border-hairline">
              <span>sem descrição</span>
              <span class="tabular-nums"><%= money(@transaction.undescribed_amount) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted text-sm">
          Este lançamento não foi detalhado.
          <%= link_to "Detalhar agora", edit_transaction_path(@transaction), class: "text-brand hover:underline" %>.
        </p>
      <% end %>
    </div>

    <div class="mt-6 pt-5 border-t border-hairline flex items-center gap-3">
      <%= link_to "Editar", edit_transaction_path(@transaction), class: "btn-primary text-sm" %>
      <%= button_to "Excluir", @transaction, method: :delete, class: "btn-ghost text-sm",
            form: { data: { turbo_confirm: "Excluir este lançamento?" } } %>
    </div>
  </div>
</div>
